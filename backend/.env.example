DATABASE_URL="mysql://user:password@localhost:3306/ai_accounts_payable"
PORT=5000
JWT_SECRET=replace_with_a_random_64_byte_hex_string
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173

# Optional: BullMQ/Redis queue for async invoice processing. If unset, invoices
# are processed inline in the backend process (fine for local dev).
REDIS_URL=

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_KEY=replace_with_a_shared_secret

# Storage: defaults to local disk (backend/uploads), no AWS account needed.
# Set STORAGE_DRIVER=s3 only once you actually have an AWS account + bucket.
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=us-east-1

# Optional error tracking (Sentry). Leave unset to disable — app behaves identically.
SENTRY_DSN=

# Field-level encryption key for sensitive vendor fields (bank account / IFSC).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

LOG_LEVEL=info
